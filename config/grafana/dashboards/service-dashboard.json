{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 0,
  "id": 1,
  "links": [],
  "panels": [
    {
      "title": "Cache Hit Rate",
      "type": "gauge",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(cache_operation_count{result=\"hit\"}[5m]) / (rate(cache_operation_count{result=\"hit\"}[5m]) + rate(cache_operation_count{result=\"miss\"}[5m])) * 100",
          "legendFormat": "Hit Rate"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      }
    },
    {
      "title": "Cache Operation Duration",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(cache_operation_duration_seconds_sum[5m]) / rate(cache_operation_duration_seconds_count[5m])",
          "legendFormat": "Average Duration"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      }
    },
    {
      "title": "Service Response Times",
      "type": "graph",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(http_server_requests_seconds_sum{status!~\"5..\"}[5m]) / rate(http_server_requests_seconds_count{status!~\"5..\"}[5m])",
          "legendFormat": "{{service}} - {{uri}}"
        }
      ],
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 27,
  "style": "dark",
  "timezone": "browser",
  "title": "TravelMate Service Dashboard",
  "uid": "travelmate",
  "version": 1
}

