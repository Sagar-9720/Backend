{
  "title": "Infrastructure Overview",
  "tags": ["infrastructure","redis","postgres","nginx"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    { "type":"stat","title":"Redis Up","datasource":"Prometheus","targets":[{"expr":"up{job=\"redis\"}"}],"gridPos":{"h":4,"w":4,"x":0,"y":0}},
    { "type":"stat","title":"Postgres Up","datasource":"Prometheus","targets":[{"expr":"up{job=\"postgres\"}"}],"gridPos":{"h":4,"w":4,"x":4,"y":0}},
    { "type":"stat","title":"Mongo Up","datasource":"Prometheus","targets":[{"expr":"up{job=\"mongo\"}"}],"gridPos":{"h":4,"w":4,"x":8,"y":0}},
    { "type":"stat","title":"Kafka Up","datasource":"Prometheus","targets":[{"expr":"up{job=\"kafka\"}"}],"gridPos":{"h":4,"w":4,"x":12,"y":0}},
    { "type":"stat","title":"Zookeeper Up","datasource":"Prometheus","targets":[{"expr":"up{job=\"zookeeper\"}"}],"gridPos":{"h":4,"w":4,"x":16,"y":0}},
    { "type":"timeseries","title":"Redis Memory","datasource":"Prometheus","targets":[{"expr":"redis_memory_used_bytes"}],"gridPos":{"h":8,"w":8,"x":0,"y":4}},
    { "type":"timeseries","title":"Redis Clients","datasource":"Prometheus","targets":[{"expr":"redis_connected_clients"}],"gridPos":{"h":8,"w":8,"x":8,"y":4}},
    { "type":"timeseries","title":"Postgres Connections","datasource":"Prometheus","targets":[{"expr":"pg_stat_database_connections"}],"gridPos":{"h":8,"w":8,"x":16,"y":4}},
    { "type":"timeseries","title":"Nginx Requests by Status","datasource":"Prometheus","targets":[{"expr":"sum(rate(nginx_http_requests_total[1m])) by (status)"}],"gridPos":{"h":8,"w":12,"x":0,"y":12}},
    { "type":"timeseries","title":"Nginx 5xx Rate by Path","datasource":"Prometheus","targets":[{"expr":"sum(rate(nginx_http_requests_total{status=~\"5..\"}[1m])) by (path)"}],"gridPos":{"h":8,"w":12,"x":12,"y":12}}
  ],
  "time": { "from":"now-6h","to":"now" }
}

