{
  "title": "Travel-Mate Microservices Overview",
  "tags": ["spring-boot","nodejs","infra"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    { "type":"stat","title":"Redis Exporter","datasource":"Prometheus","targets":[{"expr":"up{job=\"redis\"}"}],"gridPos":{"h":4,"w":4,"x":0,"y":0}},
    { "type":"stat","title":"Postgres Exporter","datasource":"Prometheus","targets":[{"expr":"up{job=\"postgres\"}"}],"gridPos":{"h":4,"w":4,"x":4,"y":0}},
    { "type":"stat","title":"Kafka Exporter","datasource":"Prometheus","targets":[{"expr":"up{job=\"kafka\"}"}],"gridPos":{"h":4,"w":4,"x":8,"y":0}},
    { "type":"stat","title":"Mongo Exporter","datasource":"Prometheus","targets":[{"expr":"up{job=\"mongo\"}"}],"gridPos":{"h":4,"w":4,"x":12,"y":0}},
    { "type":"stat","title":"Zookeeper Exporter","datasource":"Prometheus","targets":[{"expr":"up{job=\"zookeeper\"}"}],"gridPos":{"h":4,"w":4,"x":16,"y":0}},
    { "type":"timeseries","title":"Request Frequency by Service","datasource":"Prometheus","targets":[{"expr":"sum by (job) (rate(http_server_requests_seconds_count[1m]))"}],"gridPos":{"h":8,"w":12,"x":0,"y":4}},
    { "type":"timeseries","title":"Trip Creations","datasource":"Prometheus","targets":[{"expr":"sum(rate(trip_created_total[1m]))"}],"gridPos":{"h":8,"w":12,"x":12,"y":4}},
    { "type":"timeseries","title":"DB Query Avg (TripService)","datasource":"Prometheus","targets":[{"expr":"avg(rate(tripservice_db_query_duration_seconds_sum[1m]) / rate(tripservice_db_query_duration_seconds_count[1m]))"}],"gridPos":{"h":8,"w":12,"x":0,"y":12}},
    { "type":"timeseries","title":"Queue Length (JournalService)","datasource":"Prometheus","targets":[{"expr":"journalservice_queue_length"}],"gridPos":{"h":8,"w":12,"x":12,"y":12}}
  ],
  "time": { "from":"now-6h","to":"now" }
}

