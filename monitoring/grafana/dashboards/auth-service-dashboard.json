{
  "title": "AuthService Dashboard",
  "tags": ["auth-service", "spring-boot", "security"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Auth Service Status",
      "datasource": "Prometheus",
      "targets": [{"expr": "up{job=\"auth-service\"}"}],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "valueOptions": {
          "threshold": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Instance Count",
      "datasource": "Prometheus",
      "targets": [{"expr": "count(up{job=\"auth-service\"})"}],
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "gauge",
      "title": "CPU Usage",
      "datasource": "Prometheus",
      "targets": [{"expr": "sum(rate(process_cpu_seconds_total{job=\"auth-service\"}[1m])) * 100"}],
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "options": {
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 60 },
            { "color": "red", "value": 80 }
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "unit": "percent"
        }
      }
    },
    {
      "type": "gauge",
      "title": "Heap Memory Usage",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(jvm_memory_used_bytes{job=\"auth-service\",area=\"heap\"}) / sum(jvm_memory_max_bytes{job=\"auth-service\",area=\"heap\"}) * 100"
      }],
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "options": {
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 70 },
            { "color": "red", "value": 85 }
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "unit": "percent"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Authentication Activity",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum(rate(auth_login_success_total{job=\"auth-service\"}[1m]))", "legendFormat": "Login Success"},
        {"expr": "sum(rate(auth_login_failures_total{job=\"auth-service\"}[1m]))", "legendFormat": "Login Failures"},
        {"expr": "sum(rate(auth_registrations_total{job=\"auth-service\"}[1m]))", "legendFormat": "Registrations"},
        {"expr": "sum(rate(auth_token_validations_total{job=\"auth-service\"}[1m]))", "legendFormat": "Token Validations"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "type": "timeseries",
      "title": "Response Time by Endpoint",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_sum{job=\"auth-service\"}[1m])) by (uri) / sum(rate(http_server_requests_seconds_count{job=\"auth-service\"}[1m])) by (uri)",
        "legendFormat": "{{uri}}"
      }],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Active Sessions",
      "datasource": "Prometheus",
      "targets": [{"expr": "auth_sessions_active{job=\"auth-service\"}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "type": "timeseries",
      "title": "JVM Memory Usage",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "jvm_memory_used_bytes{job=\"auth-service\",area=\"heap\"}", "legendFormat": "Heap Used" },
        { "expr": "jvm_memory_committed_bytes{job=\"auth-service\",area=\"heap\"}", "legendFormat": "Heap Committed" },
        { "expr": "jvm_memory_max_bytes{job=\"auth-service\",area=\"heap\"}", "legendFormat": "Heap Max" },
        { "expr": "jvm_memory_used_bytes{job=\"auth-service\",area=\"nonheap\"}", "legendFormat": "Non-Heap Used" }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Authentication Success Rate",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(auth_login_success_total{job=\"auth-service\"}[1m])) / (sum(rate(auth_login_success_total{job=\"auth-service\"}[1m])) + sum(rate(auth_login_failures_total{job=\"auth-service\"}[1m]))) * 100",
        "legendFormat": "Success Rate"
      }],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 90 },
              { "color": "green", "value": 95 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Database Connections",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "hikaricp_connections_active{job=\"auth-service\"}",
        "legendFormat": "Active Connections"
      }, {
        "expr": "hikaricp_connections_idle{job=\"auth-service\"}",
        "legendFormat": "Idle Connections"
      }, {
        "expr": "hikaricp_connections_max{job=\"auth-service\"}",
        "legendFormat": "Max Connections"
      }],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }
      }
    }
  ],
  "time": { "from": "now-1h", "to": "now" }
}

