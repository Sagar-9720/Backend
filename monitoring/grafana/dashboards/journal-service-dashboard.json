{
  "title": "JournalService Dashboard",
  "tags": ["journal-service", "spring-boot", "microservice"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Journal Service Status",
      "datasource": "Prometheus",
      "targets": [{"expr": "up{job=\"journal-service\"}"}],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "valueOptions": {
          "threshold": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Instance Count",
      "datasource": "Prometheus",
      "targets": [{"expr": "count(up{job=\"journal-service\"})"}],
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "gauge",
      "title": "CPU Usage",
      "datasource": "Prometheus",
      "targets": [{"expr": "sum(rate(process_cpu_seconds_total{job=\"journal-service\"}[1m])) * 100"}],
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "options": {
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 60 },
            { "color": "red", "value": 80 }
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "unit": "percent"
        }
      }
    },
    {
      "type": "gauge",
      "title": "Heap Memory Usage",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(jvm_memory_used_bytes{job=\"journal-service\",area=\"heap\"}) / sum(jvm_memory_max_bytes{job=\"journal-service\",area=\"heap\"}) * 100"
      }],
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "options": {
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 70 },
            { "color": "red", "value": 85 }
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "unit": "percent"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Journal Operations",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum(rate(journal_created_total{job=\"journal-service\"}[1m]))", "legendFormat": "Created"},
        {"expr": "sum(rate(journal_updated_total{job=\"journal-service\"}[1m]))", "legendFormat": "Updated"},
        {"expr": "sum(rate(journal_deleted_total{job=\"journal-service\"}[1m]))", "legendFormat": "Deleted"},
        {"expr": "sum(rate(journal_viewed_total{job=\"journal-service\"}[1m]))", "legendFormat": "Viewed"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "type": "timeseries",
      "title": "Response Time by Endpoint",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_sum{job=\"journal-service\"}[1m])) by (uri) / sum(rate(http_server_requests_seconds_count{job=\"journal-service\"}[1m])) by (uri)",
        "legendFormat": "{{uri}}"
      }],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Tag Operations",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "sum(rate(journal_tags_added_total{job=\"journal-service\"}[1m]))", "legendFormat": "Tags Added"},
        {"expr": "sum(rate(journal_tags_removed_total{job=\"journal-service\"}[1m]))", "legendFormat": "Tags Removed"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "type": "timeseries",
      "title": "JVM Memory Usage",
      "datasource": "Prometheus",
      "targets": [
        { "expr": "jvm_memory_used_bytes{job=\"journal-service\",area=\"heap\"}", "legendFormat": "Heap Used" },
        { "expr": "jvm_memory_committed_bytes{job=\"journal-service\",area=\"heap\"}", "legendFormat": "Heap Committed" },
        { "expr": "jvm_memory_max_bytes{job=\"journal-service\",area=\"heap\"}", "legendFormat": "Heap Max" },
        { "expr": "jvm_memory_used_bytes{job=\"journal-service\",area=\"nonheap\"}", "legendFormat": "Non-Heap Used" }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Error Rate",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "sum(rate(http_server_requests_seconds_count{job=\"journal-service\",status=~\"5..\"}[1m])) / sum(rate(http_server_requests_seconds_count{job=\"journal-service\"}[1m])) * 100",
        "legendFormat": "Error Rate %"
      }],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Database Connections",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "hikaricp_connections_active{job=\"journal-service\"}",
        "legendFormat": "Active Connections"
      }, {
        "expr": "hikaricp_connections_idle{job=\"journal-service\"}",
        "legendFormat": "Idle Connections"
      }, {
        "expr": "hikaricp_connections_max{job=\"journal-service\"}",
        "legendFormat": "Max Connections"
      }],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }
      }
    }
  ],
  "time": { "from": "now-1h", "to": "now" }
}

