{
  "title": "Redis Dashboard",
  "tags": ["redis", "cache", "database"],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "stat",
      "title": "Redis Status",
      "datasource": "Prometheus",
      "targets": [{"expr": "up{job=\"redis-exporter\"}"}],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "textMode": "auto",
        "valueOptions": {
          "threshold": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "type": "stat",
      "title": "Connected Clients",
      "datasource": "Prometheus",
      "targets": [{"expr": "redis_connected_clients{job=\"redis-exporter\"}"}],
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
    },
    {
      "type": "stat",
      "title": "Memory Usage",
      "datasource": "Prometheus",
      "targets": [{"expr": "redis_memory_used_bytes{job=\"redis-exporter\"} / 1024 / 1024"}],
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "fieldConfig": {
        "defaults": {
          "unit": "MB"
        }
      }
    },
    {
      "type": "stat",
      "title": "Memory Fragmentation Ratio",
      "datasource": "Prometheus",
      "targets": [{"expr": "redis_mem_fragmentation_ratio{job=\"redis-exporter\"}"}],
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0}
    },
    {
      "type": "timeseries",
      "title": "Commands Processed",
      "datasource": "Prometheus",
      "targets": [{"expr": "rate(redis_commands_processed_total{job=\"redis-exporter\"}[1m])"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Network Traffic",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "rate(redis_net_input_bytes_total{job=\"redis-exporter\"}[1m])", "legendFormat": "Input"},
        {"expr": "rate(redis_net_output_bytes_total{job=\"redis-exporter\"}[1m])", "legendFormat": "Output"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "lineInterpolation": "smooth",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Key Operations",
      "datasource": "Prometheus",
      "targets": [
        {"expr": "rate(redis_keyspace_hits_total{job=\"redis-exporter\"}[1m])", "legendFormat": "Hits"},
        {"expr": "rate(redis_keyspace_misses_total{job=\"redis-exporter\"}[1m])", "legendFormat": "Misses"}
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "type": "gauge",
      "title": "Hit Ratio",
      "datasource": "Prometheus",
      "targets": [{
        "expr": "rate(redis_keyspace_hits_total{job=\"redis-exporter\"}[1m]) / (rate(redis_keyspace_hits_total{job=\"redis-exporter\"}[1m]) + rate(redis_keyspace_misses_total{job=\"redis-exporter\"}[1m]))",
        "instant": true
      }],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "options": {
        "minValue": 0,
        "maxValue": 1,
        "orientation": "auto",
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 0.5 },
            { "color": "green", "value": 0.7 }
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "percentunit"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Connected Clients Over Time",
      "datasource": "Prometheus",
      "targets": [{"expr": "redis_connected_clients{job=\"redis-exporter\"}"}],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20}
    },
    {
      "type": "timeseries",
      "title": "User Service Redis Operations",
      "datasource": "Prometheus",
      "targets": [{"expr": "rate(userservice_redis_operations_total[1m])"}],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true }
      }
    },
    {
      "type": "timeseries",
      "title": "Memory Usage Over Time",
      "datasource": "Prometheus",
      "targets": [{"expr": "redis_memory_used_bytes{job=\"redis-exporter\"}"}],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 28},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    }
  ],
  "time": { "from": "now-1h", "to": "now" }
}

